# LLM Provider Configuration
# 1. Built-in Engine: Works 100% out of the box with NO API keys!
DEFAULT_PROVIDER=auto

# 2. Google Gemini API (Recommended free alternative: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 3. Groq API (Optional: https://console.groq.com/keys)
GROQ_API_KEY=

# Production & Deployment
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
